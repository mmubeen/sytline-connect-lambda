SYTELINE_WSDL=http://cctsl01.cgtc.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=your-username
SYTELINE_PASS=your-password
SYTELINE_CONFIG=CCT
# Optional: Secrets Manager secret (JSON) whose values override the variables above
# (e.g. SYTELINE_PASS). Keeps the password out of the environment.
SYTELINE_SECRET_ARN=
# Used when an order omits warehouse / order_type
SYTELINE_DEFAULT_WHSE=
SYTELINE_DEFAULT_ORDTYPE=
# Live ERP writes (number allocation, inserts, note creation). OFF unless the ERP owner approved a test.
SYTELINE_LIVE_WRITES=false
# DynamoDB table with uploads; worker function invoked by the intake handler and sweeper
JOBS_TABLE=sytline-uploads
WORKER_FUNCTION_NAME=sytline-connect-worker
# Optional web-service name overrides (see src/syteline/idos.py; confirm with the read-only discovery task)
# SYTELINE_CUSTOMER_IDO=
# SYTELINE_NEXT_CO_IDO=
# SYTELINE_NEXT_JOB_IDO=
# SYTELINE_NOTE_METHOD_IDO=

# ---- SyteLine database (SQL Server) - feature 005. Used only for an operation with no web-service endpoint (see docs/DATABASE.md).
# For LOCAL runs only. In a deployment these keys come from the Secrets Manager secret named in SYTELINE_SECRET_ARN above,
# never from deploy.env (deploy.sh passes its values to CloudFormation as stack parameters: no password there).
SQL_SERVER=sql.plant.example
SQL_DATABASE=SL_PROD
SQL_USER=your-db-login
SQL_PASS=your-db-password
SQL_PORT=1433
# PEM text of the certificate(s) to trust. Required while the connection is encrypted (the default); not needed when
# SYTELINE_SQL_ENCRYPT=false. A multi-line PEM is easier to keep in the secret than in this file.
SQL_CA_PEM=
# true (default): encrypted, certificate verified. false: UNENCRYPTED connection allowed, no CA needed (warned on every connection).
SYTELINE_SQL_ENCRYPT=true
# Encrypted only: false turns off just the host-name check of the certificate
SYTELINE_SQL_VERIFY_HOSTNAME=true
SYTELINE_SQL_LOGIN_TIMEOUT=5
SYTELINE_SQL_TIMEOUT=10
SYTELINE_SITE_ID=10
# Which route each operation uses: an IDO name = web service; "database" or empty = the database above
# (when a variable is absent the earlier web-service default applies; defaults are then not read)
SYTELINE_NEXT_CO_IDO=database
SYTELINE_NEXT_JOB_IDO=database
SYTELINE_CUSTOMER_IDO=database
SYTELINE_DEFAULTS_IDO=database
# Customer search thresholds
SYTELINE_MATCH_MIN_SCORE=70
SYTELINE_MATCH_MARGIN=3
SYTELINE_MATCH_CAP=1000
