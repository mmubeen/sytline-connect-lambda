# Settings for the STAND-ALONE (no VPC) deployment. Copy to deploy.standalone.env (git-ignored) and fill in.
# Read by: ./deploy.sh --standalone   (stack "sytline-connect-standalone")
# This version creates NO network resources. By default it runs outside any VPC. To run it inside an EXISTING network
# (for example an ERP that is only reachable from the plant network), fill in ALL THREE ATTACH_* settings below.

# The SyteLine web service. https:// is required. A plain http:// address is refused unless
# ALLOW_PLAIN_HTTP=true (the ERP password would then cross the network UNENCRYPTED).
# It must be reachable from the internet; there is no fixed outbound address, so ERP allow-listing is not possible.
# Do not put credentials in the address (user:pass@host is refused).
SYTELINE_WSDL=https://erp.example.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=
# Secrets Manager secret (JSON) holding SYTELINE_PASS, in the deployment region
SYTELINE_SECRET_ARN=arn:aws-us-gov:secretsmanager:us-gov-east-1:ACCOUNT:secret:NAME
SYTELINE_CONFIG=CCT

# Deliberate opt-in to plain HTTP (leave false). Prints a warning on every deployment while it is on.
ALLOW_PLAIN_HTTP=false
# Verify the ERP's TLS certificate (leave true; false only for a self-signed test ERP)
VERIFY_TLS=true

# ---- Optional: attach to an EXISTING VPC, subnets and security group (all three, or leave all three empty) ----------
# The network must give the functions a route to the ERP AND a private path to Secrets Manager (an existing endpoint
# with private DNS, or a NAT route); the stack creates neither. The security group must allow outbound HTTPS to Secrets
# Manager and outbound access to the ERP's port. There is still no API gateway, function URL or public address.
ATTACH_VPC_ID=
ATTACH_SUBNET_IDS=
ATTACH_SG_IDS=

# AWS credentials profile (as in `aws configure list-profiles`). `./deploy.sh --standalone --profile NAME` overrides it.
AWS_PROFILE_NAME=

# Live ERP writes (add_note). Leave false. true needs LIVE_APPROVAL_REF (the ERP owner's written approval reference).
LIVE_WRITES=false
LIVE_APPROVAL_REF=

# GovCloud FIPS service endpoints (default true)
USE_FIPS_ENDPOINTS=true

# ---- Database login (feature 005): MERGED INTO THE CREDENTIALS SECRET by deploy.sh, never a stack parameter -----------
# deploy.sh reads the values below and merges them into the JSON secret named by SYTELINE_SECRET_ARN (its other keys are kept)
# before building and deploying. It asks first (--yes skips the question) and never prints the values. Leave a value empty to
# keep what the secret already holds; leave them all empty to skip the step. This file is git-ignored: once the secret has the
# values you may delete them here. The functions need a route to the database on TCP 1433.
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASS=
SQL_PORT=1433
# Path to a PEM file with the certificate(s) to trust (needed while SQL_ENCRYPT=true); stored in the secret as SQL_CA_PEM
SQL_CA_PEM_FILE=

# ---- Database connectivity check of the health action (feature 005; docs/DATABASE.md) -----------------------------
# auto (default): when the function is ATTACHED to a VPC (the three ATTACH_* settings above) the health check also tests the plant
#   SQL Server (name lookup, connection, login); a missing database key shows as a failing db_login stage. Not attached: unchanged.
# true: always (refused unless the three ATTACH_* settings are given). false: never.
# The stand-alone actions never use the database. Allow TCP 1433 from the function's security group.
DATABASE_CHECK=auto
# true (default): encrypted, certificate verified, SQL_CA_PEM required in the secret.
# false: an UNENCRYPTED connection is allowed, no CA needed; the login and password then cross the network unprotected (warned).
SQL_ENCRYPT=true
# Encrypted only: false turns off just the host-name check of the server certificate
SQL_VERIFY_HOSTNAME=true
SQL_LOGIN_TIMEOUT=5
