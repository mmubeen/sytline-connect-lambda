# Copy to deploy.env (git-ignored) and fill in. Read by ./deploy.sh (plant stack) AND ./deploy.sh --standalone (stand-alone stack).
# Layout: SHARED settings (both stacks, written once), then a PLANT ONLY block, then a STAND-ALONE ONLY block. Each mode
# ignores the other mode's block, so fill in only the blocks for the stack(s) you deploy.
# (The old deploy.standalone.env is no longer read: move its settings here and delete it.)

# ======================================================================================================================
# SHARED: used by both stacks (the same value is used whichever stack you deploy)
# ======================================================================================================================
# The SyteLine web service. The stand-alone stack refuses a plain http:// address unless ALLOW_PLAIN_HTTP=true (see its block).
# Do not put credentials in the address (user:pass@host is refused).
SYTELINE_WSDL=http://cctsl01.cgtc.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=
# Secrets Manager secret (JSON) holding SYTELINE_PASS, in the deployment region
SYTELINE_SECRET_ARN=arn:aws-us-gov:secretsmanager:us-gov-east-1:ACCOUNT:secret:NAME
SYTELINE_CONFIG=CCT

# AWS credentials profile (as in `aws configure list-profiles`) used for every AWS-facing step. Optional:
# `./deploy.sh --profile NAME` overrides it; with neither, the default credential chain is used.
AWS_PROFILE_NAME=

# Live ERP writes. Leave unset/false. To enable for an approved test window you must ALSO set
# LIVE_APPROVAL_REF to the ERP owner's written approval reference.
LIVE_WRITES=false
LIVE_APPROVAL_REF=

# GovCloud FIPS service endpoints (the template default is true)
USE_FIPS_ENDPOINTS=true

# ---- Database login (feature 005): MERGED INTO THE CREDENTIALS SECRET by deploy.sh, never a stack parameter -----------
# deploy.sh reads the values below and merges them into the JSON secret named by SYTELINE_SECRET_ARN (its other keys are kept)
# before building and deploying. It asks first (--yes skips the question) and never prints the values. Leave a value empty to
# keep what the secret already holds; leave them all empty to skip the step. This file is git-ignored: once the secret has the
# values you may delete them here. The functions need a route to the database on TCP 1433.
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASS=
SQL_PORT=1433
# Path to a PEM file with the certificate(s) to trust (needed while SQL_ENCRYPT=true); stored in the secret as SQL_CA_PEM
SQL_CA_PEM_FILE=
# true (default): the database connection is encrypted and its certificate verified (SQL_CA_PEM required in the secret).
# false: an UNENCRYPTED connection is allowed and no CA is needed; the login and password then cross the network
# unprotected and a warning is logged on every connection. A SQL Server set to Force Encryption refuses it.
SQL_ENCRYPT=true
# Encrypted connections only: false turns off just the host-name check of the server certificate (warned each connection)
SQL_VERIFY_HOSTNAME=true
# Seconds allowed for the database connection and login
SQL_LOGIN_TIMEOUT=5

# ======================================================================================================================
# PLANT ONLY: read by ./deploy.sh; ignored by ./deploy.sh --standalone
# ======================================================================================================================
SYTELINE_DEFAULT_WHSE=
SYTELINE_DEFAULT_ORDTYPE=

# ---- Host network: use an existing one, OR leave all four empty to have the stack create one --------
# Existing network: fill in ALL FOUR (private subnets with a route to the plant over the VPN; the security group must
# allow outbound HTTP port 80 to the web service and HTTPS to the AWS endpoints). Partial sets are refused.
WORKER_VPC_ID=
WORKER_SUBNET_IDS=
WORKER_SG_IDS=
WORKER_ROUTE_TABLE_IDS=
# false if the existing VPC already reaches DynamoDB and Secrets Manager (endpoints or NAT); ignored when creating
CREATE_VPC_ENDPOINTS=true

# Create the host network (all four above empty): required, no defaults.
# HOST_NETWORK_CIDR must not overlap the plant network or any network you connect to it (IPv4, /16 to /25).
HOST_NETWORK_CIDR=
# Plant address range(s) the functions may reach on HTTP port 80 (PLANT_CIDR_1 required; 2 and 3 optional)
PLANT_CIDR_1=
PLANT_CIDR_2=
PLANT_CIDR_3=
# Optional: the AWS-managed DynamoDB prefix list (pl-...) to limit HTTPS egress to DynamoDB
DYNAMODB_PREFIX_LIST_ID=
# The plant connection (VPN gateway, VPN connection, route to the plant range) is NOT created: the network team
# does that after the deployment, using the stack outputs (see docs/DEPLOYMENT.md).

# ---- API-caller endpoint (execute-api interface endpoint approved clients use) -------------------------
# Existing endpoint: set API_VPCE_ID and leave CREATE_API_ENDPOINT=false.
# Or, only while creating the host network, set CREATE_API_ENDPOINT=true and leave API_VPCE_ID empty.
API_VPCE_ID=
CREATE_API_ENDPOINT=false

# ---- Job-number workflow (reserve / save): the PO details are read from an IDP accelerator stack's documents --------
# All three of the first group, or none. Without them reserve and save answer IDP_UNAVAILABLE.
IDP_STACK_NAME=
IDP_OUTPUT_BUCKET=
IDP_TRACKING_TABLE=
# Region of the IDP stack (empty = the region of this stack)
IDP_REGION=
# Path to a checkout of the IDP accelerator; its idp_sdk and idp_common are packaged with the functions at build time.
IDP_REPO=
# The functions need a private path to S3 and CloudFormation (VPC endpoints or a NAT route); the stack creates neither.
# Optional: ARN of the IDP document-processing state machine (same account and region as this stack). When given, the IDP's
# "execution SUCCEEDED" events start the event intake: it reads the document and, if usable and LIVE_WRITES=true, reserves
# the job numbers and saves the order (docs/EVENT_INTAKE.md). Empty: nothing starts automatically. Needs IDP_STACK_NAME.
IDP_STATE_MACHINE_ARN=

# ---- Which route each ERP operation uses (feature 005). Leave at `database` unless the SyteLine web service has an
# endpoint for the operation: then put that endpoint's IDO name here and the web service is used for that operation.
NEXT_CO_IDO=database
NEXT_JOB_IDO=database
CUSTOMER_IDO=database
DEFAULTS_IDO=database

# ---- Tuning (defaults shown equal the code's defaults; leave alone unless you need to change them) -------------------
# Database: site id for the numbering routines; statement time limit in seconds
SITE_ID=10
SQL_TIMEOUT=10
# Customer search on the database route: minimum confident score (0-100), lead over the runner-up, candidate rows read
MATCH_MIN_SCORE=70
MATCH_MARGIN=3
MATCH_CAP=1000
# IDP document: expected class (empty = any) and a JSON object overriding where the PO details sit in the result,
# e.g. IDP_FIELD_MAP='{"po_number":"purchase_order","line.item":"sku"}'  (keys as in src/syteline/idp_fields.py; keep the
# single quotes, this file is read by the shell). UNCONFIRMED names.
IDP_DOCUMENT_CLASS=
IDP_FIELD_MAP=

# ======================================================================================================================
# STAND-ALONE ONLY: read by ./deploy.sh --standalone; ignored by ./deploy.sh
# ======================================================================================================================
# By default the stand-alone stack runs outside any VPC. To run it inside an EXISTING network (for example an ERP that is only
# reachable from the plant network), fill in ALL THREE ATTACH_* settings (or leave all three empty). The network must give the
# functions a route to the ERP AND a private path to Secrets Manager (an existing endpoint with private DNS, or a NAT route);
# the stack creates neither. The security group must allow outbound HTTPS to Secrets Manager and outbound access to the ERP's
# port. There is still no API gateway, function URL or public address.
ATTACH_VPC_ID=
ATTACH_SUBNET_IDS=
ATTACH_SG_IDS=

# Deliberate opt-in to a plain http:// SYTELINE_WSDL (leave false). The ERP password then crosses the network UNENCRYPTED;
# a warning is printed on every deployment while it is on. Without it the stand-alone stack refuses an http:// address.
ALLOW_PLAIN_HTTP=false
# Verify the ERP's TLS certificate (leave true; false only for a self-signed test ERP)
VERIFY_TLS=true

# ---- Database connectivity check of the health action (docs/DATABASE.md) -------------------------------------------
# auto (default): when the function is ATTACHED to a VPC (the three ATTACH_* settings above) the health check also tests the
#   plant SQL Server (name lookup, connection, login); a missing database key shows as a failing db_login stage. Not attached:
#   unchanged.
# true: always (refused unless the three ATTACH_* settings are given). false: never.
# The stand-alone actions never use the database otherwise. Allow TCP 1433 from the function's security group.
DATABASE_CHECK=auto
