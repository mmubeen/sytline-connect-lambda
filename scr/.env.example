SYTELINE_WSDL=http://cctsl01.cgtc.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=your-username
SYTELINE_PASS=your-password
SYTELINE_CONFIG=CCT
# Optional: Secrets Manager secret (JSON) whose values override the variables above
# (e.g. SYTELINE_PASS). Keeps the password out of the environment.
SYTELINE_SECRET_ARN=
# Used when an order omits warehouse / order_type
SYTELINE_DEFAULT_WHSE=
SYTELINE_DEFAULT_ORDTYPE=
# Live ERP writes (number allocation, inserts, note creation). OFF unless the ERP owner approved a test.
SYTELINE_LIVE_WRITES=false
# DynamoDB table with uploads; worker function invoked by the intake handler and sweeper
JOBS_TABLE=sytline-uploads
WORKER_FUNCTION_NAME=sytline-connect-worker
# Optional web-service name overrides (see scr/syteline/idos.py; confirm with the read-only discovery task)
# SYTELINE_CUSTOMER_IDO=
# SYTELINE_NEXT_CO_IDO=
# SYTELINE_NEXT_JOB_IDO=
# SYTELINE_NOTE_METHOD_IDO=
