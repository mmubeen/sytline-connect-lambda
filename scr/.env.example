SYTELINE_WSDL=http://cctsl01.cgtc.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=your-username
SYTELINE_PASS=your-password
SYTELINE_CONFIG=CCT
# Optional: Secrets Manager secret (JSON) whose values override the variables above
# (SYTELINE_PASS, SYTELINE_SQL_USER, SYTELINE_SQL_PASS ...). Keeps passwords out of env.
SYTELINE_SECRET_ARN=
# Used when an order omits warehouse / order_type
SYTELINE_DEFAULT_WHSE=
SYTELINE_DEFAULT_ORDTYPE=
# SyteLine SQL Server. No default port: verify the listener with Chromalloy IT, do not assume 1433.
SYTELINE_SQL_HOST=
SYTELINE_SQL_PORT=
SYTELINE_SQL_DB=
SYTELINE_SQL_USER=
SYTELINE_SQL_PASS=
# Live ERP writes (number allocation, inserts, notes). OFF unless the ERP owner approved a test.
SYTELINE_LIVE_WRITES=false
# DynamoDB table with upload jobs; worker function invoked by the intake handler
JOBS_TABLE=sytline-upload-jobs
WORKER_FUNCTION_NAME=sytline-connect-worker
