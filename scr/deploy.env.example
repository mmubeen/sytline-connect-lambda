# Copy to deploy.env (git-ignored) and fill in. Read by ./deploy.sh.
SYTELINE_WSDL=http://cctsl01.cgtc.com/IDORequestService/IDOWebService.asmx?wsdl
SYTELINE_USER=
# Secrets Manager secret (JSON) holding SYTELINE_PASS, in us-gov-east-1
SYTELINE_SECRET_ARN=arn:aws-us-gov:secretsmanager:us-gov-east-1:ACCOUNT:secret:NAME
SYTELINE_CONFIG=CCT
SYTELINE_DEFAULT_WHSE=
SYTELINE_DEFAULT_ORDTYPE=

# execute-api interface VPC endpoint that approved clients use to call the private API
API_VPCE_ID=vpce-xxxxxxxx

# Worker network: private subnets with a route to the plant over the VPN; the security group must allow
# outbound HTTP port 80 to the web service (and HTTPS to the AWS endpoints below).
WORKER_VPC_ID=vpc-xxxxxxxx
WORKER_SUBNET_IDS=subnet-aaaaaaaa,subnet-bbbbbbbb
WORKER_SG_IDS=sg-xxxxxxxx
WORKER_ROUTE_TABLE_IDS=rtb-xxxxxxxx
# false if the VPC already reaches DynamoDB and Secrets Manager (endpoints or NAT)
CREATE_VPC_ENDPOINTS=true

# Live ERP writes. Leave unset/false. To enable for an approved test window you must ALSO set
# LIVE_APPROVAL_REF to the ERP owner's written approval reference.
LIVE_WRITES=false
LIVE_APPROVAL_REF=
